{
  "schema_version": "tool-registry.v2",
  "registry_id": "fitz_sage_v2",
  "tools": [
    {
      "tool_id": "set_retrieval_plan",
      "tool_family": "planning",
      "description": "Create or revise the retrieval plan for the current research objective.",
      "capabilities": ["plan_retrieval"],
      "input_modalities": ["agent_state", "text"],
      "output_modalities": ["plan"],
      "evidence_roles": ["none"],
      "side_effect_class": "local_state_write",
      "argument_schema": {"type": "object", "properties": {"objective": {"type": "string"}}, "required": ["objective"]},
      "constraints": ["none"],
      "prerequisites": ["objective_available"]
    },
    {
      "tool_id": "search_bm25",
      "tool_family": "content_retrieval",
      "description": "Search indexed document content using lexical relevance and return passage candidates.",
      "capabilities": ["search_content", "lexical_match", "retrieve_passages"],
      "input_modalities": ["text", "pdf", "code"],
      "output_modalities": ["evidence_candidates"],
      "evidence_roles": ["candidate_discovery"],
      "side_effect_class": "read",
      "argument_schema": {"type": "object", "properties": {"query": {"type": "string"}, "limit": {"type": "integer"}}, "required": ["query"]},
      "constraints": ["indexed_sources_required"],
      "prerequisites": ["query_available"]
    },
    {
      "tool_id": "grep_search",
      "tool_family": "exact_retrieval",
      "description": "Search text or source code for an exact identifier, phrase, or regular expression.",
      "capabilities": ["exact_pattern_search", "identifier_search"],
      "input_modalities": ["text", "code"],
      "output_modalities": ["evidence_candidates"],
      "evidence_roles": ["candidate_discovery"],
      "side_effect_class": "read",
      "argument_schema": {"type": "object", "properties": {"pattern": {"type": "string"}, "source_scope": {"type": "array", "items": {"type": "string"}}}, "required": ["pattern"]},
      "constraints": ["textual_source_required"],
      "prerequisites": ["query_available"]
    },
    {
      "tool_id": "search_metadata",
      "tool_family": "metadata_retrieval",
      "description": "Filter and search source metadata rather than document body content.",
      "capabilities": ["search_metadata", "filter_sources"],
      "input_modalities": ["metadata"],
      "output_modalities": ["source_list"],
      "evidence_roles": ["source_discovery"],
      "side_effect_class": "read",
      "argument_schema": {"type": "object", "properties": {"query": {"type": "string"}, "filters": {"type": "object"}}, "required": []},
      "constraints": ["metadata_catalog_required"],
      "prerequisites": ["none"]
    },
    {
      "tool_id": "list_sources",
      "tool_family": "source_discovery",
      "description": "List available research sources when the source inventory is unknown or incomplete.",
      "capabilities": ["list_sources", "discover_sources"],
      "input_modalities": ["metadata"],
      "output_modalities": ["source_list"],
      "evidence_roles": ["source_discovery"],
      "side_effect_class": "read",
      "argument_schema": {"type": "object", "properties": {"scope": {"type": "string"}}, "required": []},
      "constraints": ["none"],
      "prerequisites": ["none"]
    },
    {
      "tool_id": "list_tabular_sources",
      "tool_family": "source_discovery",
      "description": "List available CSV, Excel, and SQLite sources for structured research.",
      "capabilities": ["list_sources", "discover_structured_sources"],
      "input_modalities": ["metadata"],
      "output_modalities": ["source_list"],
      "evidence_roles": ["source_discovery"],
      "side_effect_class": "read",
      "argument_schema": {"type": "object", "properties": {"scope": {"type": "string"}}, "required": []},
      "constraints": ["structured_sources_available"],
      "prerequisites": ["none"]
    },
    {
      "tool_id": "inspect_table_schema",
      "tool_family": "structured_inspection",
      "description": "Inspect tables, columns, and types before issuing a structured row query.",
      "capabilities": ["inspect_structured_schema", "discover_fields"],
      "input_modalities": ["csv", "excel", "sqlite"],
      "output_modalities": ["schema"],
      "evidence_roles": ["structure_discovery"],
      "side_effect_class": "read",
      "argument_schema": {"type": "object", "properties": {"source_id": {"type": "string"}, "table": {"type": "string"}}, "required": ["source_id"]},
      "constraints": ["structured_source_required"],
      "prerequisites": ["source_selected"]
    },
    {
      "tool_id": "search_table_rows",
      "tool_family": "structured_retrieval",
      "description": "Query structured table rows using known fields, filters, and value constraints.",
      "capabilities": ["search_structured_records", "filter_records"],
      "input_modalities": ["csv", "excel", "sqlite"],
      "output_modalities": ["evidence_candidates"],
      "evidence_roles": ["candidate_discovery"],
      "side_effect_class": "read",
      "argument_schema": {"type": "object", "properties": {"source_id": {"type": "string"}, "filters": {"type": "object"}, "limit": {"type": "integer"}}, "required": ["source_id", "filters"]},
      "constraints": ["structured_source_required"],
      "prerequisites": ["schema_known"]
    },
    {
      "tool_id": "list_pdf_sources",
      "tool_family": "source_discovery",
      "description": "List available PDF documents before selecting a document for inspection or search.",
      "capabilities": ["list_sources", "discover_pdf_sources"],
      "input_modalities": ["metadata"],
      "output_modalities": ["source_list"],
      "evidence_roles": ["source_discovery"],
      "side_effect_class": "read",
      "argument_schema": {"type": "object", "properties": {"scope": {"type": "string"}}, "required": []},
      "constraints": ["pdf_sources_available"],
      "prerequisites": ["none"]
    },
    {
      "tool_id": "inspect_pdf_structure",
      "tool_family": "document_inspection",
      "description": "Inspect PDF page structure and document organization before targeted page search.",
      "capabilities": ["inspect_document_structure", "discover_sections"],
      "input_modalities": ["pdf"],
      "output_modalities": ["document_structure"],
      "evidence_roles": ["structure_discovery"],
      "side_effect_class": "read",
      "argument_schema": {"type": "object", "properties": {"source_id": {"type": "string"}}, "required": ["source_id"]},
      "constraints": ["pdf_source_required"],
      "prerequisites": ["source_selected"]
    },
    {
      "tool_id": "search_pdf_pages",
      "tool_family": "document_retrieval",
      "description": "Search selected PDF pages for relevant passages and page-level evidence candidates.",
      "capabilities": ["search_document_pages", "retrieve_passages"],
      "input_modalities": ["pdf"],
      "output_modalities": ["evidence_candidates"],
      "evidence_roles": ["candidate_discovery"],
      "side_effect_class": "read",
      "argument_schema": {"type": "object", "properties": {"source_id": {"type": "string"}, "query": {"type": "string"}, "pages": {"type": "array", "items": {"type": "integer"}}}, "required": ["source_id", "query"]},
      "constraints": ["pdf_source_required"],
      "prerequisites": ["source_selected"]
    },
    {
      "tool_id": "read_file",
      "tool_family": "content_inspection",
      "description": "Read the selected local source content for direct inspection and evidence extraction.",
      "capabilities": ["read_content", "inspect_full_source"],
      "input_modalities": ["text", "code"],
      "output_modalities": ["content"],
      "evidence_roles": ["evidence_inspection"],
      "side_effect_class": "read",
      "argument_schema": {"type": "object", "properties": {"source_id": {"type": "string"}, "offset": {"type": "integer"}, "limit": {"type": "integer"}}, "required": ["source_id"]},
      "constraints": ["local_source_required"],
      "prerequisites": ["source_selected"]
    },
    {
      "tool_id": "inspect_code",
      "tool_family": "code_inspection",
      "description": "Inspect source-code symbols, definitions, and relationships for implementation evidence.",
      "capabilities": ["inspect_code_structure", "resolve_symbols"],
      "input_modalities": ["code"],
      "output_modalities": ["content", "code_structure"],
      "evidence_roles": ["evidence_inspection"],
      "side_effect_class": "read",
      "argument_schema": {"type": "object", "properties": {"source_id": {"type": "string"}, "symbol": {"type": "string"}}, "required": ["source_id"]},
      "constraints": ["code_source_required"],
      "prerequisites": ["source_selected"]
    },
    {
      "tool_id": "inspect_evidence",
      "tool_family": "evidence_inspection",
      "description": "Inspect one evidence candidate deeply before it is used for synthesis or governance.",
      "capabilities": ["inspect_evidence", "verify_provenance"],
      "input_modalities": ["evidence_candidates"],
      "output_modalities": ["evidence"],
      "evidence_roles": ["evidence_inspection"],
      "side_effect_class": "read",
      "argument_schema": {"type": "object", "properties": {"evidence_id": {"type": "string"}}, "required": ["evidence_id"]},
      "constraints": ["candidate_evidence_required"],
      "prerequisites": ["evidence_candidate_selected"]
    },
    {
      "tool_id": "expand_context",
      "tool_family": "evidence_inspection",
      "description": "Expand surrounding context when an evidence snippet is incomplete or ambiguous.",
      "capabilities": ["expand_context", "resolve_split_context"],
      "input_modalities": ["evidence_candidates", "evidence"],
      "output_modalities": ["evidence"],
      "evidence_roles": ["context_expansion"],
      "side_effect_class": "read",
      "argument_schema": {"type": "object", "properties": {"evidence_id": {"type": "string"}, "window": {"type": "integer"}}, "required": ["evidence_id"]},
      "constraints": ["incomplete_context_required"],
      "prerequisites": ["evidence_candidate_selected"]
    },
    {
      "tool_id": "compare_evidence",
      "tool_family": "evidence_synthesis",
      "description": "Compare multiple inspected evidence items for agreement, differences, or contradictions.",
      "capabilities": ["compare_evidence", "detect_contradictions"],
      "input_modalities": ["evidence"],
      "output_modalities": ["evidence_comparison"],
      "evidence_roles": ["evidence_synthesis"],
      "side_effect_class": "none",
      "argument_schema": {"type": "object", "properties": {"evidence_ids": {"type": "array", "items": {"type": "string"}}}, "required": ["evidence_ids"]},
      "constraints": ["multiple_evidence_required"],
      "prerequisites": ["evidence_inspected"]
    },
    {
      "tool_id": "update_requirement_progress",
      "tool_family": "governance",
      "description": "Update requirement completion using the current canonical inspected evidence set.",
      "capabilities": ["update_requirements", "track_coverage"],
      "input_modalities": ["evidence", "agent_state"],
      "output_modalities": ["governance_state"],
      "evidence_roles": ["governance_update"],
      "side_effect_class": "local_state_write",
      "argument_schema": {"type": "object", "properties": {"requirement_id": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}, "required": ["requirement_id"]},
      "constraints": ["tracked_requirements_required"],
      "prerequisites": ["evidence_inspected"]
    },
    {
      "tool_id": "assess_evidence",
      "tool_family": "governance",
      "description": "Assess whether current inspected evidence satisfies all tracked research requirements.",
      "capabilities": ["assess_evidence", "validate_sufficiency"],
      "input_modalities": ["evidence", "governance_state"],
      "output_modalities": ["assessment"],
      "evidence_roles": ["governance_assessment"],
      "side_effect_class": "local_state_write",
      "argument_schema": {"type": "object", "properties": {"evidence_ids": {"type": "array", "items": {"type": "string"}}}, "required": ["evidence_ids"]},
      "constraints": ["canonical_evidence_set_required"],
      "prerequisites": ["requirements_updated"]
    },
    {
      "tool_id": "finalize_document_selection",
      "tool_family": "terminal",
      "description": "Finalize the document selection after a fresh sufficient governance assessment.",
      "capabilities": ["finalize_selection", "emit_terminal_result"],
      "input_modalities": ["assessment", "governance_state"],
      "output_modalities": ["terminal_result"],
      "evidence_roles": ["terminal_decision"],
      "side_effect_class": "local_state_write",
      "argument_schema": {"type": "object", "properties": {"selected_source_ids": {"type": "array", "items": {"type": "string"}}}, "required": ["selected_source_ids"]},
      "constraints": ["fresh_sufficient_assessment_required"],
      "prerequisites": ["requirements_complete"]
    }
  ]
}
