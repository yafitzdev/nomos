{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitz-tool.local/schema/runner_request.v2.json",
  "title": "Generic router request",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "request_id",
    "question",
    "agent_state",
    "history",
    "observed_evidence",
    "governance",
    "resource_state",
    "source_state",
    "query_state",
    "tool_registry",
    "legal_candidate_ids"
  ],
  "properties": {
    "schema_version": {"const": "runner-request.v2"},
    "request_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "agent_state": {"type": "object"},
    "history": {"type": "array"},
    "plan": {"type": "object"},
    "observed_evidence": {"type": "array"},
    "governance": {"type": "object"},
    "resource_state": {"type": "object"},
    "source_state": {"type": "object"},
    "query_state": {"type": "object"},
    "tool_registry": {"$ref": "tool_registry.v2.json"},
    "legal_candidate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
