{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitz-tool.local/schema/scenario.v1.json",
  "title": "Fitz-Tool generated testcase scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "matrix_version",
    "matrix_cell",
    "source_card_ids",
    "state_setup",
    "question",
    "difficult_paraphrase",
    "expected_facts",
    "expected_tools",
    "expected_terminal_state",
    "type_signature",
    "instance_signature",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "scenario.v1"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "matrix_version": {
      "const": "matrix.v1"
    },
    "matrix_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id"],
      "properties": {
        "cell_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_card_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "state_setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_name", "history", "observed_evidence", "requirements", "governance"],
      "properties": {
        "state_name": {
          "type": "string",
          "minLength": 1
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "observed_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["evidence_id"],
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["requirement_id", "status"],
            "properties": {
              "requirement_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "governance": {
          "type": "object",
          "additionalProperties": true,
          "required": ["assessment_fresh", "path"],
          "properties": {
            "assessment_fresh": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "question": {
      "type": "string",
      "minLength": 10
    },
    "difficult_paraphrase": {
      "type": "string",
      "minLength": 10
    },
    "expected_facts": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "fact_id"],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "fact_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expected_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_terminal_state": {
      "enum": [
        "ongoing",
        "selection",
        "abstention",
        "clarification",
        "unresolved_contradiction",
        "step_limit_termination"
      ]
    },
    "type_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instance_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teacher",
        "model",
        "prompt_version",
        "seed",
        "source_card_hashes",
        "generated_at"
      ],
      "properties": {
        "teacher": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer"
        },
        "source_card_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "generated_at": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
