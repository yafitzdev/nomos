{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitz-tool.local/schema/matrix.v1.json",
  "title": "Fitz-Tool generation matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrix_version", "dimensions"],
  "properties": {
    "matrix_version": {
      "const": "matrix.v1"
    },
    "dimensions": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sampling_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_condition_profile"],
      "properties": {
        "terminal_condition_profile": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
