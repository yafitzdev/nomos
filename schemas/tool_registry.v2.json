{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitz-tool.local/schema/tool_registry.v2.json",
  "title": "Agent-agnostic tool registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "tools"],
  "properties": {
    "schema_version": {"const": "tool-registry.v2"},
    "registry_id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,127}$"},
    "registry_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tool"}
    }
  },
  "$defs": {
    "tokenList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"}
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "tool_family",
        "description",
        "capabilities",
        "input_modalities",
        "output_modalities",
        "evidence_roles",
        "side_effect_class",
        "argument_schema"
      ],
      "properties": {
        "tool_id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,127}$"},
        "tool_family": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "description": {"type": "string", "minLength": 12},
        "capabilities": {"$ref": "#/$defs/tokenList"},
        "input_modalities": {"$ref": "#/$defs/tokenList"},
        "output_modalities": {"$ref": "#/$defs/tokenList"},
        "evidence_roles": {"$ref": "#/$defs/tokenList"},
        "side_effect_class": {
          "enum": ["none", "read", "local_state_write", "external_write", "irreversible_external_write"]
        },
        "argument_schema": {"type": "object"},
        "constraints": {"$ref": "#/$defs/tokenList"},
        "prerequisites": {"$ref": "#/$defs/tokenList"}
      }
    }
  }
}
